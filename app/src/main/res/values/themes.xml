<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeyboardApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:statusBarColor">@color/accent</item>
    </style>
    <style name="KbToolbarBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
